{
  "notion": {
    "type": "http",
    "url": "https://mcp.notion.com/mcp"
  },
  "pptx": {
    "command": "uvx",
    "args": ["--with", "mcp<2", "--from", "office-powerpoint-mcp-server", "ppt_mcp_server"]
  },
  "hwp-mcp": {
    "command": "uvx",
    "args": ["--with", "mcp<2", "--from", "hwp-mcp", "hwp-mcp"]
  },
  "playwright": {
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/playwright-mcp.mjs", "@playwright/mcp@0.0.83"]
  },
  "jedi-work-chrome": {
    "command": "npx",
    "args": ["-y", "chrome-devtools-mcp@1.10.1", "--browserUrl", "http://127.0.0.1:9333", "--performanceCrux=false", "--screenshotFormat", "jpeg", "--screenshotMaxWidth", "1280"],
    "env": { "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1" }
  }
}
